import re
import pandas as pd

def extract_tests(df, id_col="ID", text_col="test details"):
    rows = []

    for _, row in df.iterrows():
        record_id = row[id_col]
        raw_text = row[text_col]

        if pd.isna(raw_text):
            continue

        # 找每一个 test 块
        test_blocks = re.findall(
            r'<Test_x0020_Name.*?>.*?</Analytics_x0020_Scripts_x0020_-_x0020_Additional_x0020_Comments>',
            raw_text,
            flags=re.S
        )

        for block in test_blocks:
            def find(pattern):
                m = re.search(pattern, block, re.S)
                return m.group(1).strip() if m else None

            rows.append({
                "ID": record_id,   # 👈 关键就在这里
                "Test_Name": find(r'<Test_x0020_Name.*?>(.*?)</Test_x0020_Name>'),
                "Test_Description": find(r'<TestDescription.*?>(.*?)</TestDescription>'),
                "Analytics_Comments": find(
                    r'<Analytics_x0020_Scripts_x0020_-_x0020_Additional_x0020_Comments.*?>(.*?)</Analytics_x0020_Scripts_x0020_-_x0020_Additional_x0020_Comments>'
                )
            })

    return pd.DataFrame(rows)
